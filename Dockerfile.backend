# Backend Dockerfile - Standalone for Dokploy
FROM oven/bun:1-alpine

WORKDIR /app

# Copy shared package FIRST
COPY shared ./shared

# Copy backend source
COPY backend/server.ts ./server.ts
COPY backend/src ./src

# Create minimal package.json - use file: protocol for local package
RUN printf '{"name":"backend","type":"module","dependencies":{\
"bcrypt":"^6.0.0",\
"cookie-parser":"^1.4.7",\
"cors":"^2.8.6",\
"dotenv":"^17.4.2",\
"express":"^5.2.1",\
"helmet":"^8.3.0",\
"jsonwebtoken":"^9.0.3",\
"mongoose":"^8.0.0",\
"morgan":"^1.11.0",\
"multer":"^2.2.0",\
"slugify":"^1.6.9",\
"@news-portal/shared":"file:./shared"}}' > package.json

# Install dependencies
RUN bun install --production

# Create uploads directory
RUN mkdir -p /app/uploads

EXPOSE 5000

CMD ["bun", "run", "server.ts"]
