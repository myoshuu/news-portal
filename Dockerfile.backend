# Backend Dockerfile - Standalone for Dokploy
FROM oven/bun:1-alpine

WORKDIR /app

# Copy backend files
COPY backend/package.json ./package.json
COPY backend/bun.lock* ./bun.lock
COPY backend/tsconfig.json ./tsconfig.json
COPY backend/server.ts ./server.ts
COPY backend/src ./src

# Copy shared package (mimic workspace structure)
COPY shared/package.json ./node_modules/@news-portal/shared/package.json
COPY shared/index.ts ./node_modules/@news-portal/shared/index.ts

# Install dependencies (without frozen lockfile due to workspace)
RUN bun install

# Create uploads directory
RUN mkdir -p /app/uploads

EXPOSE 5000

CMD ["bun", "run", "server.ts"]
