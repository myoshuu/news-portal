# Backend Dockerfile - Standalone for Dokploy
FROM oven/bun:1-alpine

WORKDIR /app

# Copy backend files
COPY backend/package.json ./package.json
COPY backend/bun.lock* ./bun.lock
COPY backend/tsconfig.json ./tsconfig.json
COPY backend/server.ts ./server.ts
COPY backend/src ./src

# Copy shared package to node_modules
COPY shared ./node_modules/@news-portal/shared

# Fix package.json - replace workspace dep with file path
RUN sed -i 's|"@news-portal/shared": "workspace:\\*"|"@news-portal/shared": "file:node_modules/@news-portal/shared"|g' package.json

# Install dependencies
RUN bun install

# Create uploads directory
RUN mkdir -p /app/uploads

EXPOSE 5000

CMD ["bun", "run", "server.ts"]
