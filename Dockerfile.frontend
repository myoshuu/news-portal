# Frontend Dockerfile - Standalone for Dokploy
FROM oven/bun:1-alpine

WORKDIR /app

# Copy shared package FIRST
COPY shared ./shared

# Copy frontend source
COPY frontend/vite.config.ts ./vite.config.ts
COPY frontend/index.html ./index.html
COPY frontend/components.json ./components.json
COPY frontend/src ./src
COPY frontend/public ./public
COPY frontend/tsconfig*.json ./

# Copy frontend package.json
COPY frontend/package.json ./package.json

# Replace workspace:* with the local path file:./shared
RUN sed -i 's/"workspace:\*"/"file:\.\/shared"/g' package.json

# Install dependencies
RUN bun install

# Build with vite
RUN bunx vite build

# Production stage - serve with Bun
FROM oven/bun:1-alpine

WORKDIR /app

# Install serve for static file serving
RUN bun add -g serve

# Copy built files
COPY --from=0 /app/dist ./dist

EXPOSE 3000

CMD ["serve", "-l", "3000", "dist"]
